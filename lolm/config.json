{
  "gameId": "lolm",
  "gameName": "英雄联盟手游",
  "gameIcon": "⚔️",
  "hasLanes": true,
  "lanes": [
    { "id": "top", "name": "上路", "dataFile": "上路.json" },
    { "id": "jungle", "name": "打野", "dataFile": "打野.json" },
    { "id": "mid", "name": "中路", "dataFile": "中路.json" },
    { "id": "adc", "name": "下路", "dataFile": "下路.json" },
    { "id": "support", "name": "辅助", "dataFile": "辅助.json" }
  ],
  "algorithm": {
    "type": "zscore",
    "weights": { "wr": 0.5, "pr": 1.0, "br": 3.0 },
    "simpleWrExp": 0.3,
    "simpleBrBoost": 2.5
  },
  "tiers": {
    "thresholds": [
      { "tier": "T0",   "pct": 0.92 },
      { "tier": "T0.5", "pct": 0.88 },
      { "tier": "T1",   "pct": 0.70 },
      { "tier": "T2",   "pct": 0.40 },
      { "tier": "T3",   "pct": 0.12 },
      { "tier": "T4",   "pct": 0.00 }
    ],
    "colors": {
      "T0": "#ff4d4f", "T0.5": "#ff7a45", "T1": "#ffa940",
      "T2": "#ffc53d", "T3": "#73d13d", "T4": "#8c8c8c"
    }
  },
  "columns": [
    { "label": "英雄", "field": "name", "type": "text" },
    { "label": "梯度", "field": "tier", "type": "tier" },
    { "label": "评分", "field": "score", "type": "score" },
    { "label": "胜率", "field": "wr", "type": "pct", "colorClass": "wr" },
    { "label": "出场率", "field": "pr", "type": "pct" },
    { "label": "Ban率", "field": "br", "type": "pct" },
    { "label": "BP率", "field": "bp", "type": "pct" }
  ],
  "globalColumns": [
    { "label": "英雄", "field": "name", "type": "text" },
    { "label": "分路", "field": "lane", "type": "text" },
    { "label": "分路梯度", "field": "tier", "type": "tier" },
    { "label": "全局评分", "field": "scoreGlobal", "type": "score" },
    { "label": "胜率", "field": "wr", "type": "pct", "colorClass": "wr" },
    { "label": "出场率", "field": "pr", "type": "pct" },
    { "label": "Ban率", "field": "br", "type": "pct" },
    { "label": "BP率", "field": "bp", "type": "pct" }
  ],
  "statCards": [
    { "label": "平均胜率", "field": "wr", "format": "pct" },
    { "label": "平均出场率", "field": "pr", "format": "pct" },
    { "label": "平均Ban率", "field": "br", "format": "pct" }
  ],
  "headIconPath": "HeadIcon/{name}.png",
  "footer": "LoLM Hero Tier List · 算法来源于王者荣耀梯度逆推分析 · 仅供参考"
}
